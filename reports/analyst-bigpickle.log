#!/bin/bash
UA="Mozilla/5.0 (passive verifier)"
BASE="https://api.kassenkompass.de"
probe() {
  local label="$1"; local path="$2"; shift 2
  local body; local code
  code=$(curl -sS --max-time 12 -A "$UA" -o /tmp/opencode/body.txt -w "%{http_code}" -H "Host: api.kassenkompass.de" "$@" "$BASE$path" 2>/dev/null)
  body=$(tr -d '\n' < /tmp/opencode/body.txt | cut -c1-180)
  printf '%s %-52s -> %s | %s\n' "$label" "$path" "$code" "$body"
  sleep 1.1
}
# --- Batch 1: v2 router-404 oracle endpoint sweep (registered => 401, unknown => 404 JSON) ---
for w in insurance_info users user sync health settlement_report question_tree cat_detail insurance_info health_insurance health_insurance_savings health_insurance_comparison detail_comparison state post delete partner settings products tariffs data config api status search offers rates; do
  probe V2SW "/v2/$w" -H "X-API-Secret: invalid"
done
EOF
