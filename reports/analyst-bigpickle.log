import subprocess, sys, time
specs = sys.argv[1:]
for s in specs:
    u, extra = s.split("||",1)
    hargs = []
    for h in extra.split("|"):
        hargs += ["-H", h]
    try:
        p = subprocess.run(["curl","-sS","-m","15","-D","-","-o","/tmp/body2.txt","-w","%{http_code}",u]+hargs,capture_output=True,text=True)
        raw = p.stdout
        code = p.stderr
        lines = raw.split("\n")
        print(f"### {u} extra={extra}")
        print(f"  status={lines[-1].strip()}")
        print("  RESPONSE_HEADERS:")
        for ln in lines:
            if ln.strip():
                print("    "+ln.rstrip())
        try:
            with open("/tmp/body2.txt","rb") as f:
                b=f.read()
            print("  body="+b[:120].decode("utf-8","replace").replace("\n","\\n"))
        except Exception as e:
            print(f"  body=<err {e}>")
    except Exception as e:
        print(f"### {u} ERROR {e}")
    time.sleep(1.1)
PY
