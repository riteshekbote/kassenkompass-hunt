name: Reposcan (KassenKompass GmbH)

on:
  schedule:
    - cron: "*/20 * * * *"
  workflow_dispatch:

permissions:
  contents: write

env:
  PROBE_ALLOW: "kassenkompass.de"
  TARGET_ORG: ""   # set to a public GitHub org if one is known, else leave empty

jobs:
  reposcan:
    runs-on: ubuntu-latest
    timeout-minutes: 25
    concurrency:
      group: reposcan-kassenkompass
      cancel-in-progress: true
    env:
      MODEL_ID: opencode/mimo-v2.5-free
    steps:
      - name: Checkout
        uses: actions/checkout@v5

      - name: Install OpenCode
        run: |
          export PATH="$HOME/.opencode/bin:$HOME/.local/bin:$HOME/.npm-global/bin:$PATH"
          if command -v opencode >/dev/null 2>&1; then opencode --version; exit 0; fi
          npm install -g opencode-ai 2>/dev/null || npm install -g --prefix "$HOME/.npm-global" opencode-ai 2>/dev/null || true
          if ! command -v opencode >/dev/null 2>&1; then
            for i in 1 2 3; do
              curl -fsSL https://opencode.ai/install | bash && break
              echo "opencode.ai installer attempt $i failed, retrying in 15s..."; sleep 15
            done
          fi
          export PATH="$HOME/.opencode/bin:$HOME/.local/bin:$HOME/.npm-global/bin:$PATH"
          opencode --version

==> .github/workflows/sync-issues.yml <==
name: Sync Issues (KassenKompass GmbH)

on:
  workflow_run:
    workflows: ["Deep Hunt (KassenKompass GmbH)"]
    types: [completed]
  workflow_dispatch:

permissions:
  issues: write
  contents: read

concurrency:
  group: sync-issues-kassenkompass
  cancel-in-progress: true

jobs:
  sync:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout
        uses: actions/checkout@v5

      - name: Setup Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.11"

      - name: Install PyGithub
        run: pip install PyGithub

      - name: Sync leads to issues
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GITHUB_REPOSITORY: ${{ github.repository }}
          LEAD_GLOB: "leads/lead-*.md"
          TARGET_NAME: kassenkompass
        run: python scripts/sync-issues.py


