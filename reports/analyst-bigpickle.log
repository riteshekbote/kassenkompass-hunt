/**
 * Param-Passthrough — kk-web-draft (Marketing-Site)
 *
 * Zweck (E3, Website-App-Trennung 2026-08-30): Die Marketing-Site führt kein
 * php/standard.php der App mehr aus. Damit Partner-Attribution (?lizenz=) und
 * Kampagnen-Parameter (utm_*) beim Absprung in den Funnel nicht verloren gehen,
 * werden sie hier clientseitig eingesammelt, in sessionStorage gehalten und an
 * jeden Funnel-Link wieder angehängt. Der Funnel (App, gleiche Domain) setzt
 * dann wie heute Cookie + linkklick serverseitig.
 *
 * Zusätzlich setzt die Slim-standard.php der Marketing-Site die lizenz-/JDC-
 * Cookies auch serverseitig — dieses Script ist der Belt-and-Braces-Weg für
 * utm_* (dafür gibt es keine Cookies) und für Navigation INNERHALB der
 * Marketing-Site (Landung auf Artikel -> Klick zur Startseite -> Funnel-CTA),
 * wo die Query-Parameter aus der URL verschwunden sind.
 *
 * Review-Härtung 2026-08-30: URL-Auflösung über document.baseURI (identisch
 * zur Browser-Auflösung), Funnel-Erkennung über geparsten pathname (matcht
 * relative, pfad-absolute UND same-host-absolute hrefs); fremde Hosts werden
 * NIE dekoriert (keine Param-Leaks an externe Ziele).
 */
(function () {
    'use strict';

    // Parameter, die in den Funnel weitergereicht werden.
    // lizenz + utm_* = Partner-/Kampagnen-Attribution (App: standard.php:29-34)
    // jid/agn/ppn/... = JDC-Absprung-Metafelder (App: standard.php:47-61)
    // fra/direkt = Fragebaum-/Direktmodus-Steuerung aus Partner-Links
    var PASS_PARAMS = [
        'lizenz',
        'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term',
        'jid', 'customerid', 'agn', 'connectionnumber',
        'ppn', 'poolpartnernummer', 'employeenumber', 'advisorid',
        'fra', 'direkt'
    ];

    var STORE_KEY = 'kkweb_pass_params';

    // Funnel-Einstiege der App (Pfad-Match, pathname beginnt immer mit /)
    var FUNNEL_PATH_RE = /^\/(bonusrechner[a-z0-9_]*\.php|termin\.php)$/i;

    function readStored() {
        try {
            var raw = sessionStorage.getItem(STORE_KEY);
            return raw ? JSON.parse(raw) : {};
        } catch (e) { return {}; }
    }

    function collectFromUrl() {
        var found = {};
        try {
            var qs = new URLSearchParams(window.location.search);
            PASS_PARAMS.forEach(function (p) {
                var v = qs.get(p);
                if (v !== null && v !== '' && v.length <= 128) { found[p] = v; }
            });
        } catch (e) { /* alte Browser: kein Passthrough, kein Bruch */ }
        return found;
    }

    function store(found) {
        try {
            var merged = readStored();
            Object.keys(found).forEach(function (k) { merged[k] = found[k]; });
            if (Object.keys(merged).length) {
                sessionStorage.setItem(STORE_KEY, JSON.stringify(merged));
            }
            return merged;
        } catch (e) { return found; }
    }

    // Parst eine href relativ zur Dokument-URL (wie der Browser) und liefert
    // das URL-Objekt NUR, wenn es ein same-host-Funnel-Ziel ist — sonst null.
    function funnelTarget(href) {
        try {
            var u = new URL(href, document.baseURI);
            if (u.host !== window.location.host) { return null; }
            if (!FUNNEL_PATH_RE.test(u.pathname)) { return null; }
            return u;
        } catch (e) { return null; }
    }

    function decorate(u, params) {
        Object.keys(params).forEach(function (k) {
            if (!u.searchParams.has(k)) { u.searchParams.set(k, params[k]); }
        });
        // Pfad-Form beibehalten — Host nie hart verdrahten (Test-/Prod-neutral)
        return u.pathname + u.search + u.hash;
    }

    var params = store(collectFromUrl());

    function apply() {
        if (!Object.keys(params).length) { return; }

        // 1) <a href>-Links auf Funnel-Ziele (relativ, pfad-absolut oder same-host-absolut)
        try {
            var links = document.querySelectorAll('a[href]');
            for (var i = 0; i < links.length; i++) {
