let menuOpen = false;

function togglemenu() {
    const str1 = document.getElementById("str1");
    const str2 = document.getElementById("str2");
    const str3 = document.getElementById("str3");

    if (!menuOpen) {
        str1.style.transform = "translateY(10px) rotate(45deg)";
        str1.style.transformOrigin = "center center";
        str2.style.opacity = "0";
        str3.style.transform = "translateY(-10px) rotate(-45deg)";
        str3.style.transformOrigin = "center center";
        document.getElementById("mobmenu").style.height = "300px";
        document.getElementById("mobmenu").style.boxShadow = "rgba(0, 0, 0, 0.1) 0px 8px 23px 0px";
        menuOpen = true;
    } else {
        str1.style.transform = "translateY(0px) rotate(0deg)";
        str2.style.opacity = "1";
        str3.style.transform = "translateY(0px) rotate(0deg)";
        document.getElementById("mobmenu").style.height = "0px";
        document.getElementById("mobmenu").style.boxShadow = "none";

        menuOpen = false;
    }
}

function toggleadmenu(triggerElement) {
    const menu = triggerElement.closest('.ad_menu');
    const computedTransform = window.getComputedStyle(menu).transform;
    // The default matrix for translateX(-90%) is not a string match, so check if it's not identity
    if (computedTransform === "none" || computedTransform === "matrix(1, 0, 0, 1, 0, 0)") {
        menu.style.transform = "translateX(-90%)";
        triggerElement.style.transform = "rotate(0deg)";
    } else {
        menu.style.transform = "translateX(0%)";
        triggerElement.style.transform = "rotate(180deg)";
    }
}

