			resetErrors(input_kk, error_kk);
			resetErrors(input_bund, error_bund);
			errortooltipp.style.display = "none";
			buttonholder.style.marginTop = "34px";

			//abfragelogik
			if(input_kk.value != "" && input_kk.value != null){
				if(suggestions.includes(input_kk.value)){
					setsuccess(input_kk);
				}else{
					seterror(input_kk, error_kk, 'Wähle deine aktuelle Krankenkasse aus der Liste');
					validate = false;
				}
			}else{
				seterror(input_kk, error_kk, 'Wähle deine aktuelle Krankenkasse aus');
				validate = false;
			}

			if(input_bund.value != "none"){
				setsuccess(input_bund);
			}else{
				seterror(input_bund, error_bund, 'Wähle dein Bundesland aus');
				validate = false;
			}

			//abschluss bei erfolg
			if(validate){
				document.getElementById("nextbut").click();
			}else{
				errortooltipp.style.display = "initial";
				buttonholder.style.marginTop = "120px";
			}

		}




		

	</script>
