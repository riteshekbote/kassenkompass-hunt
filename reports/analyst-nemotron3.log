function setsuccess(inputfield, color = '#089355') {
    console.log('setsuccess called for:', inputfield.id, 'with color:', color);
    inputfield.style.setProperty("border", "1px solid " + color, "important");
    inputfield.style.setProperty("color", color, "important");
    console.log('Applied styles - border:', inputfield.style.border, 'color:', inputfield.style.color);
}

function seterror(inputfield, errorfield, errortext) {
    inputfield.style.setProperty("border", "1px solid #B91740", "important");
    errorfield.innerHTML = errortext;

    // Show error icon if it exists
    const errorIcon = document.getElementById('errorimg_' + inputfield.id);
    if (errorIcon) {
        errorIcon.style.display = 'block';
    }
}

function resetErrors(inputfield, errorfield, color = '#D5D7DA') {
    inputfield.style.setProperty("border", "1px solid " + color, "important");
    errorfield.innerHTML = '';
    inputfield.style.color = '#717680';

    // Hide error icon if it exists
    const errorIcon = document.getElementById('errorimg_' + inputfield.id);
    if (errorIcon) {
        errorIcon.style.display = 'none';
    }
}

function toggleInfoBox(event) {
  event.stopPropagation(); // verhindert Schließen beim Klick auf das Icon

  const container = event.currentTarget;
  const isActive = container.classList.contains("active");

  // Alle Boxen schließen
  document
    .querySelectorAll(".info-icon-container")
    .forEach((el) => el.classList.remove("active"));

    // Falls vorher nicht aktiv, jetzt aktivieren
    if (!isActive) {
        container.classList.add('active');
    }
}

// Klick außerhalb schließt alle Boxen
document.addEventListener('click', () => {
    document.querySelectorAll('.info-icon-container').forEach(el => el.classList.remove('active'));
});

