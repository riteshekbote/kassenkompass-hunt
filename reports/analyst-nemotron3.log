/**
 * Whitelabel Live-Preview Receiver
 *
 * Hört auf postMessage-Events von der Whitelabel-Konfig-Seite und überschreibt
 * die vom Server gerenderten CSS-Variablen + Hooks in einem dedizierten
 * <style id="wl-vars-live">-Block.
 *
 * WICHTIG: Die hier abgebildete CSS-Build-Logik ist ein 1:1-JS-Spiegel von
 *   htmlincludes/whitelabel/whitelabel_styles.php
 * Jede neue Style-Hook-Regel muss auch hier ergänzt werden, sonst greift
 * sie zwar nach dem Speichern, aber nicht im Live-Editor.
 *
 * Erwartete Message:
 *   { type: 'wl-preview', brand: { color_primary: '#…', button_style: 'solid', … } }
 *
 * Sicherheit:
 * - same-origin Voraussetzung (Editor + Funnel laufen auf gleicher Domain)
 * - postMessage erlaubt zwar Cross-Origin, aber wir validieren strikt
 *   den Message-Typ + Whitelisten die Brand-Keys + Sanitize jeden Wert
 */
(function () {
	'use strict';

	const HEX = /^#[0-9a-f]{3}([0-9a-f]{3})?$/i;
	const isHex = v => typeof v === 'string' && HEX.test(v);
	const pickEnum = (v, allowed) => allowed.indexOf(v) !== -1 ? v : null;
	const sanitizeFont = v => (typeof v === 'string') ? v.replace(/[^a-zA-Z0-9 _\-,']/g, '') : '';

	const RADIUS_MAP = { leicht: '4px', mittel: '10px', stark: '20px' };

	const BTN_SELECTORS =
		'body.wl-active button, body.wl-active input[type="submit"], ' +
		'body.wl-active .bn_searchbut, body.wl-active .bnv_button, ' +
		'body.wl-active .ad_changebut';

	const BTN_TEXT_SELECTORS =
		'body.bn_bodystan.wl-active button, body.bn_bodystan.wl-active button *, ' +
		'body.bn_bodystan.wl-active input[type="submit"], ' +
		'body.bn_bodystan.wl-active .bn_searchbut, body.bn_bodystan.wl-active .bn_searchbut *, ' +
		'body.bn_bodystan.wl-active .bnv_button, body.bn_bodystan.wl-active .bnv_button *, ' +
		'body.bn_bodystan.wl-active .ad_changebut, body.bn_bodystan.wl-active .ad_changebut *';

	const BTN_SVG_SELECTORS =
		'body.bn_bodystan.wl-active button svg path, ' +
		'body.bn_bodystan.wl-active input[type="submit"] svg path, ' +
		'body.bn_bodystan.wl-active .bn_searchbut svg path, ' +
		'body.bn_bodystan.wl-active .bnv_button svg path, ' +
		'body.bn_bodystan.wl-active .ad_changebut svg path';

	function buildCss(brand) {
		const col_primary     = isHex(brand.color_primary)         ? brand.color_primary         : null;
		const col_secondary   = isHex(brand.color_secondary)       ? brand.color_secondary       : null;
		const col_background  = isHex(brand.color_background)      ? brand.color_background      : null;
		const col_text        = isHex(brand.color_text)            ? brand.color_text            : null;
		const col_button      = isHex(brand.color_button)          ? brand.color_button          : null;
		const col_button_text = isHex(brand.color_button_text)     ? brand.color_button_text     : null;
		const col_card_bg     = isHex(brand.color_card_background) ? brand.color_card_background : null;
		const col_card_border = isHex(brand.color_card_border)     ? brand.color_card_border     : null;
		const col_highlight   = isHex(brand.color_highlight)       ? brand.color_highlight       : null;

		const button_style = pickEnum(brand.button_style, ['clean', 'solid', 'outline']);
		const border_radius = pickEnum(brand.border_radius, ['leicht', 'mittel', 'stark']);
		const card_style = pickEnum(brand.card_style, ['minimal', 'modern', 'elevated']);
		const font_family = sanitizeFont(brand.font_family);

		// Dekorations-Toggles (Default = sichtbar; explizit 0 → ausblenden)
		const asBool = v => (v === 1 || v === '1' || v === true) ? 1 : (v === 0 || v === '0' || v === false ? 0 : 1);
		const show_ornaments      = asBool(brand.show_ornaments);
		const show_stars          = asBool(brand.show_stars);
		const show_deco_pattern   = asBool(brand.show_deco_pattern);
		const show_side_structure = asBool(brand.show_side_structure);

		const btn_text_color = col_button_text || '#ffffff';

		const out = [];

		// Auto-Hide (Spiegel von whitelabel_styles.php)
		out.push(
			'body.wl-active .bnv_inputframe.bnve_kk_card.assup_con,' +
			'body.wl-active .assup_con,' +
			'body.wl-active .bnv_trustwrapper,' +
			'body.wl-active .bnv_logowrapper,' +
			'body.wl-active .bnv_trustratebox,' +
			'body.wl-active .bnv2_trust_wrapper,' +
			'body.wl-active .bnv2_trust_badge_text,' +
			'body.wl-active .bnv2_trust_badge,' +
			'body.wl-active .bnv_trustraterate,' +
			'body.wl-active .bn_ver_faq,' +
			'body.wl-active #faqcon,' +
			'body.wl-active .bn_ver_faqheader,' +
			'body.wl-active .bn_ver_faqmorewrapper,' +
			'body.wl-active .bn_det_toggleaccord#faqcon,' +
			'body.wl-active .bnve_faqwrapper,' +
			'body.wl-active .bnve_support,' +
			'body.wl-active .bnv_footer,' +
			'body.wl-active .bnv_footer2,' +
			'body.wl-active .bnv_legalmenu { display: none !important; }'
		);

		// Gegenstück zum Legal-Menü-Hide: rechtes Header-Ornament bei WL wieder zeigen (Spiegel von whitelabel_styles.php;
		// Ornament ist visibility:hidden-Platzhalter im Flex-Flow — nur Sichtbarkeit zurückdrehen, kein display)
		out.push('body.wl-active .bnv_legalmenu_ornamentfallback { visibility: visible !important; }');

		// Dekorations-Toggles — nur Hide-Regel ausgeben, wenn explizit deaktiviert
		if (show_ornaments === 0) {
			out.push('body.wl-active .bnv_onl, body.wl-active .bnv_onr { display: none !important; }');
		}
		if (show_stars === 0) {
			out.push('body.wl-active .bnve_headstarsleft, body.wl-active .bnve_headstarsright { display: none !important; }');
		}
		if (show_deco_pattern === 0) {
			out.push('body.wl-active .ind_decopicture_left, body.wl-active .ind_decopicture_right { display: none !important; }');
		}
		if (show_side_structure === 0) {
			out.push('body.wl-active .bnv2_sidestructureleft, body.wl-active .bnv2_sidestructureright { display: none !important; }');
		}

		// F5: Padding-Bottom-Bug-Fix nach Trust-Wrapper-Hide
		out.push('body.wl-active .bnv_inputframe { padding-bottom: 100px !important; }');

		// F7: Gender-Quest-Wrapper auf Brand-Farben (nur Farben, kein Layout)
		if (col_card_bg) {
			out.push('body.wl-active .bnv_genderquestwrapper { background-color: ' + col_card_bg + ' !important; }');
		}
		if (col_card_border) {
			out.push('body.wl-active .bnv_genderquestwrapper { border-color: ' + col_card_border + ' !important; }');
		}
		if (col_text) {
			out.push('body.wl-active .bnv_genderquestwrapper { color: ' + col_text + ' !important; }');
		}

		// Background / Text
		if (col_background) {
			out.push('body.wl-active, body.wl-active .bn_bodystan { background-color: ' + col_background + ' !important; }');
		}
		if (col_text) {
			out.push('body.wl-active, body.wl-active p, body.wl-active label, body.wl-active span:not(.wl_status_badge) { color: ' + col_text + ' !important; }');
		}

		// Primärfarbe (nur Überschriften)
		if (col_primary) {
			out.push('body.wl-active h1, body.wl-active h2, body.wl-active .bnv_mainheader, body.wl-active .bnv_inputheader { color: ' + col_primary + ' !important; }');
		}

		// Karte
		if (col_card_bg) {
			out.push('body.wl-active .bnv_inputframe { background-color: ' + col_card_bg + ' !important; }');
		}
		if (col_card_border) {
			out.push('body.wl-active .bnv_inputframe { border: 2px solid ' + col_card_border + ' !important; }');
		}

		// Highlight (Vorschlags-Dropdown)
		if (col_highlight) {
			out.push('body.wl-active .in_sec1_vorschlag:hover, body.wl-active .in_sec1_vorschlag.highlighted { background-color: ' + col_highlight + ' !important; }');
		}

		// Sekundärfarbe — Info-Box (lila Info-Marker = Text + inline-SVG-Icon)
		if (col_secondary) {
			out.push('body.wl-active .bnv_infochecktext, body.wl-active .bnv_infocheck { color: ' + col_secondary + ' !important; }');
		}

		// Sekundärbutton (.bnve_detailbutton): Rahmen + Schrift Primärfarbe, BG Kartenhintergrund
		// Bewusst unabhängig vom button_style-Setting.
		if (col_primary) {
			let secBtn = 'body.wl-active .bnve_detailbutton { border: 2px solid ' + col_primary + ' !important; color: ' + col_primary + ' !important;';
			if (col_card_bg) secBtn += ' background-color: ' + col_card_bg + ' !important;';
			secBtn += ' }';
			out.push(secBtn);
			out.push('body.wl-active .bnve_detailbutton .bnve_detailbuttext, body.wl-active .bnve_detailbutton p, body.wl-active .bnve_detailbutton span { color: ' + col_primary + ' !important; }');
			out.push('body.wl-active .bnve_detailbutton svg path { stroke: ' + col_primary + ' !important; }');
		}

		// Button-Hintergrund + Text
		if (col_button) {
			out.push(BTN_SELECTORS + ' { background: ' + col_button + ' !important; background-image: none !important; border-color: ' + col_button + ' !important; }');
			out.push(BTN_TEXT_SELECTORS + ' { color: ' + btn_text_color + ' !important; }');
		}

		// Button-SVG-Stroke
		if (col_button || col_button_text) {
			out.push(BTN_SVG_SELECTORS + ' { stroke: ' + btn_text_color + ' !important; }');
		}

		// Buttonstil
		if (button_style === 'clean') {
			out.push(BTN_SELECTORS + ' { border: none !important; box-shadow: none !important; }');
		} else if (button_style === 'outline' && col_button) {
			out.push(BTN_SELECTORS + ' { background: transparent !important; background-image: none !important; border: 2px solid ' + col_button + ' !important; }');
			out.push(BTN_TEXT_SELECTORS + ' { color: ' + col_button + ' !important; }');
			out.push(BTN_SVG_SELECTORS + ' { stroke: ' + col_button + ' !important; }');
		}

		// Border-Radius (Buttons + Karte + Sekundärbutton)
		if (border_radius && RADIUS_MAP[border_radius]) {
			out.push(BTN_SELECTORS + ', body.wl-active .bnve_detailbutton, body.wl-active .bnv_inputframe { border-radius: ' + RADIUS_MAP[border_radius] + ' !important; }');
